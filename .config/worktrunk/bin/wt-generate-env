#!/usr/bin/env python3
"""Generate per-worktree env files for Docker Compose and the app."""

import os
import sys


def getenv(name: str):
    value = os.environ.get(name)
    if not value:
        print(f"wt-generate-env: {name} is not set", file=sys.stderr)
        sys.exit(1)
    return value


def main():
    worktree = getenv("WORKTREE_NAME")
    compose = getenv("COMPOSE_NAME")
    app_port = getenv("APP_PORT")
    db_port = getenv("DATABASE_PORT")
    db_name = getenv("DB_NAME")
    db_url = f"postgres://postgres:dev@localhost:{db_port}/{db_name}"

    vars = [
        f"WORKTREE_NAME={worktree}",
        f"COMPOSE_PROJECT_NAME={compose}",
        f"APP_PORT={app_port}",
        f"DATABASE_PORT={db_port}",
        f"DATABASE_URL={db_url}",
    ]

    compose_block = "# AUTO-GENERATED BY WORKTRUNK\n" + "\n".join(vars) + "\n"
    with open(".env.compose", "w") as f:
        _ = f.write(compose_block)


if __name__ == "__main__":
    main()
