#!/usr/bin/env python3
"""Generate per-worktree env files for Docker Compose and the app."""

import os
import sys


def getenv(name: str):
    value = os.environ.get(name)
    if not value:
        print(f"wt-generate-env: {name} is not set", file=sys.stderr)
        sys.exit(1)
    return value


def main():
    worktree = getenv("WORKTREE_NAME")
    compose = getenv("COMPOSE_NAME")
    app_port = getenv("APP_PORT")
    db_port = getenv("POSTGRES_PORT")
    db_name = getenv("DB_NAME")
    minio_port = getenv("MINIO_PORT")
    minio_console_port = getenv("MINIO_CONSOLE_PORT")
    db_user = "peace_user"
    db_password = "peace_test"
    db_url = f"postgres://{db_user}:{db_password}@localhost:{db_port}/{db_name}"
    minio_url = f"http://localhost:{minio_port}"

    compose_vars = [
        f"WORKTREE_NAME={worktree}",
        f"COMPOSE_PROJECT_NAME={compose}",
        f"APP_PORT={app_port}",
        f"POSTGRES_PORT={db_port}",
        f"POSTGRES_DB={db_name}",
        f"MINIO_PORT={minio_port}",
        f"MINIO_CONSOLE_PORT={minio_console_port}",
    ]
    compose_block = "# AUTO-GENERATED BY WORKTRUNK\n" + "\n".join(compose_vars) + "\n"
    with open(".env.compose", "w") as f:
        _ = f.write(compose_block)

    compose_override = f"""# AUTO-GENERATED BY WORKTRUNK
services:
  postgres:
    environment:
      POSTGRES_DB: {db_name}
    ports:
      - '{db_port}:5432'
  minio:
    ports:
      - '{minio_port}:9000'
      - '{minio_console_port}:9001'
"""
    with open("docker-compose.worktree.yml", "w") as f:
        _ = f.write(compose_override)

    update_env_file(
        ".env.development.local",
        {"DATABASE_URL": db_url, "AWS_ENDPOINT_URL": minio_url},
    )


def update_env_file(path: str, updates: dict[str, str]):
    lines: list[str] = []
    seen = set()

    if os.path.exists(path):
        with open(path) as f:
            lines = f.read().splitlines()

        for i, line in enumerate(lines):
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if "=" in stripped:
                key = stripped.split("=", 1)[0]
                if key in updates:
                    lines[i] = f'{key}="{updates[key]}"'
                    seen.add(key)

    new_keys = [k for k in updates if k not in seen]
    if new_keys:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append("# AUTO-GENERATED BY WORKTRUNK")
        for key in new_keys:
            lines.append(f'{key}="{updates[key]}"')

    with open(path, "w") as f:
        _ = f.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    main()
