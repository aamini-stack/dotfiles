#!/usr/bin/env python3
"""Generate per-worktree env files for Docker Compose and the app."""
import os
import re
import sys


def getenv(name):
    value = os.environ.get(name)
    if not value:
        print(f"wt-generate-env: {name} is not set", file=sys.stderr)
        sys.exit(1)
    return value


def main():
    worktree = getenv("WORKTREE_NAME")
    compose = getenv("COMPOSE_NAME")
    app_port = getenv("APP_PORT")
    db_port = getenv("DATABASE_PORT")
    db_name = getenv("DB_NAME")
    db_url = f"postgres://postgres:dev@localhost:{db_port}/{db_name}"

    vars = [
        f"WORKTREE_NAME={worktree}",
        f"COMPOSE_PROJECT_NAME={compose}",
        f"APP_PORT={app_port}",
        f"DATABASE_PORT={db_port}",
        f"DATABASE_URL={db_url}",
    ]

    compose_block = "# AUTO-GENERATED BY WORKTRUNK\n" + "\n".join(vars) + "\n"
    with open(".env.compose", "w") as f:
        f.write(compose_block)

    generated = "# wt-start\n# AUTO-GENERATED BY WORKTRUNK\n" + "\n".join(vars) + "\n# wt-end"
    env_file = ".env.development.local"
    if os.path.exists(env_file):
        with open(env_file) as f:
            content = f.read()
        content = re.sub(r"(?m)^# wt-start\s*\n.*?^# wt-end\s*\n?", "", content, flags=re.DOTALL)
        content = content.rstrip()
        if content:
            content += "\n\n" + generated + "\n"
        else:
            content = generated + "\n"
    else:
        content = generated + "\n"

    with open(env_file, "w") as f:
        f.write(content)


if __name__ == "__main__":
    main()
