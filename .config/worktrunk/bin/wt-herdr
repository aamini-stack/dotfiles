#!/usr/bin/env python3
"""Helpers for integrating worktrunk with herdr.

Subcommands:
  focus <worktree-path>              Focus the herdr workspace for a worktree.
  open <worktree-path> [repo-path]   Focus or create the herdr workspace for a path.
  tail <branch> [worktree-path]      Tail worktrunk hook logs for a branch.
"""

import json
import os
import select
import subprocess
import sys
import time
from pathlib import Path


def run(cmd, check=True, capture=True, **kwargs):
    result = subprocess.run(cmd, check=check, capture_output=capture, text=True, **kwargs)
    if capture:
        return result.stdout.strip()
    return ""


def run_json(cmd, check=True, **kwargs):
    stdout = run(cmd, check=check, **kwargs)
    if not stdout:
        return {}
    return json.loads(stdout)


def herdr_json(cmd):
    return run_json(["herdr"] + list(cmd))["result"]


def get_workspace_root_pane(ws_id):
    tabs = herdr_json(["tab", "list", "--workspace", ws_id]).get("tabs", [])
    if not tabs:
        return None
    first_tab_id = tabs[0]["tab_id"]
    panes = herdr_json(["pane", "list", "--workspace", ws_id]).get("panes", [])
    for pane in panes:
        if pane.get("tab_id") == first_tab_id:
            return pane["pane_id"]
    return None


def find_workspace_by_path(worktree_path: str) -> tuple[str | None, bool]:
    """Return (workspace_id, is_worktree_associated)."""
    for ws in herdr_json(["workspace", "list"]).get("workspaces", []):
        wt = ws.get("worktree")
        if wt and os.path.realpath(wt.get("checkout_path", "")) == worktree_path:
            return ws["workspace_id"], True
    for ws in herdr_json(["workspace", "list"]).get("workspaces", []):
        root_pane = get_workspace_root_pane(ws["workspace_id"])
        if not root_pane:
            continue
        pane = herdr_json(["pane", "get", root_pane]).get("pane", {})
        cwd = os.path.realpath(pane.get("cwd") or pane.get("foreground_cwd") or "")
        if cwd == worktree_path:
            return ws["workspace_id"], False
    return None, False


def find_source_workspace(repo_path: str) -> str | None:
    """Return the herdr workspace ID for the repo's main/source worktree."""
    try:
        data = herdr_json(["worktree", "list", "--cwd", repo_path, "--json"])
    except Exception as e:
        print(f"herdr worktree list failed: {e}", file=sys.stderr)
        return None
    source = data.get("source", {})
    if source.get("source_workspace_id"):
        return source["source_workspace_id"]
    source_path = source.get("source_checkout_path")
    if source_path:
        for ws in herdr_json(["workspace", "list"]).get("workspaces", []):
            wt = ws.get("worktree")
            if wt and os.path.realpath(wt.get("checkout_path", "")) == os.path.realpath(source_path) and not wt.get("is_linked_worktree"):
                return ws["workspace_id"]
    return None


# ---------------------------------------------------------------------------
# focus / open
# ---------------------------------------------------------------------------


def open_worktree(worktree_path: str, repo_path: str | None = None) -> None:
    worktree_path = os.path.realpath(worktree_path)

    # If the workspace is already open and associated with the worktree, focus it.
    ws_id, is_worktree = find_workspace_by_path(worktree_path)
    if ws_id and is_worktree:
        print(f"Focusing existing worktree workspace {ws_id}", file=sys.stderr)
        run(["herdr", "workspace", "focus", ws_id], check=False)
        return

    # If a plain workspace is squatting on this path, close it so we can open a
    # proper herdr worktree workspace in the same repo group.
    if ws_id and not is_worktree:
        print(f"Closing plain workspace {ws_id} on {worktree_path}", file=sys.stderr)
        run(["herdr", "workspace", "close", ws_id], check=False)

    # Prefer herdr's native worktree open, which keeps the workspace in the same
    # repo group as the source workspace.
    if repo_path:
        repo_path = os.path.realpath(repo_path)
        source_ws = find_source_workspace(repo_path)
        if source_ws:
            print(f"Opening worktree {worktree_path} from source workspace {source_ws}", file=sys.stderr)
            try:
                herdr_json([
                    "worktree", "open",
                    "--workspace", source_ws,
                    "--path", worktree_path,
                    "--focus",
                ])
                return
            except Exception as e:
                print(f"herdr worktree open failed: {e}", file=sys.stderr)
        else:
            print(f"No source workspace found for {repo_path}", file=sys.stderr)
    else:
        print("No repo_path provided; falling back to plain workspace", file=sys.stderr)

    # Fallback: create a plain workspace.
    print(f"Creating plain workspace for {worktree_path}", file=sys.stderr)
    label = Path(worktree_path).name
    herdr_json(["workspace", "create", "--cwd", worktree_path, "--label", label, "--no-focus"])
    ws_id, _ = find_workspace_by_path(worktree_path)
    if ws_id:
        run(["herdr", "workspace", "focus", ws_id], check=False)


def focus_worktree(worktree_path: str) -> None:
    worktree_path = os.path.realpath(worktree_path)
    ws_id, is_worktree = find_workspace_by_path(worktree_path)
    if ws_id:
        run(["herdr", "workspace", "focus", ws_id], check=False)
        return
    print(f"No herdr workspace found for {worktree_path}", file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------------
# tail
# ---------------------------------------------------------------------------

def find_branch_dir(log_root: Path, branch: str) -> Path | None:
    sanitized = branch.replace("/", "-").replace("\\", "-")
    candidates = []
    for d in log_root.iterdir():
        if not d.is_dir():
            continue
        if d.name == sanitized:
            return d
        if sanitized in d.name:
            candidates.append(d)
    return candidates[0] if candidates else None


def tail_branch(branch: str, cwd: Path | None = None) -> None:
    if cwd:
        os.chdir(cwd)

    log_root = Path(".git/wt/logs")
    while not log_root.exists():
        print("Waiting for worktrunk logs directory...")
        sys.stdout.flush()
        time.sleep(0.2)

    branch_dir = None
    while branch_dir is None:
        branch_dir = find_branch_dir(log_root, branch)
        if branch_dir is None:
            time.sleep(0.2)

    print(f"Observing worktrunk hooks: {branch_dir.name}")
    sys.stdout.flush()

    seen: set[Path] = set()
    procs: list[subprocess.Popen] = []

    try:
        while True:
            for log_file in sorted(branch_dir.rglob("*.log")):
                if log_file in seen:
                    continue
                seen.add(log_file)
                rel = log_file.relative_to(branch_dir)
                print(f"\n=== {rel} ===\n")
                sys.stdout.flush()

                proc = subprocess.Popen(
                    ["tail", "-n", "0", "-F", str(log_file)],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                )
                os.set_blocking(proc.stdout.fileno(), False)
                procs.append(proc)

            if procs:
                pipes = [p.stdout for p in procs if p.poll() is None and p.stdout]
                if pipes:
                    readable, _, _ = select.select(pipes, [], [], 0.5)
                    for pipe in readable:
                        try:
                            data = pipe.read(65536)
                            if data:
                                sys.stdout.write(data)
                                sys.stdout.flush()
                        except Exception:
                            pass

            procs = [p for p in procs if p.poll() is None]

            if not procs:
                time.sleep(0.2)
    except KeyboardInterrupt:
        pass
    finally:
        for p in procs:
            p.terminate()


# ---------------------------------------------------------------------------
# entrypoint
# ---------------------------------------------------------------------------

def main() -> None:
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <focus|open|tail> ...", file=sys.stderr)
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "focus":
        if len(sys.argv) < 3:
            print(f"Usage: {sys.argv[0]} focus <worktree-path>", file=sys.stderr)
            sys.exit(1)
        focus_worktree(sys.argv[2])
    elif cmd == "open":
        if len(sys.argv) < 3:
            print(f"Usage: {sys.argv[0]} open <worktree-path> [repo-path]", file=sys.stderr)
            sys.exit(1)
        open_worktree(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None)
    elif cmd == "tail":
        if len(sys.argv) < 3:
            print(f"Usage: {sys.argv[0]} tail <branch> [worktree-path]", file=sys.stderr)
            sys.exit(1)
        branch = sys.argv[2]
        cwd = Path(sys.argv[3]) if len(sys.argv) > 3 else None
        tail_branch(branch, cwd)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
