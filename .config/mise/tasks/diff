#!/usr/bin/env bash
#MISE description="Diff modified images against HEAD"
#MISE dir="{{cwd}}"
#USAGE arg "[expected]" help="Baseline/expected screenshot"
#USAGE arg "[actual]" help="Actual screenshot"
#USAGE flag "-f --format <format>" help="Diff format: side-by-side or overlay" default="side-by-side"

set -eu
[ -n "${usage_expected:-}" ] && usage_expected="$(realpath "$usage_expected")"
[ -n "${usage_actual:-}" ] && usage_actual="$(realpath "$usage_actual")"
cd "$(git rev-parse --show-toplevel)"
tmp_dir="$(mktemp -d -t mise-diff-XXXXXX)"
cleanup() { rm -rf "$tmp_dir"; }
trap cleanup EXIT
fmt="${usage_format:-side-by-side}"
make_diff() {
  expected="$1"
  actual="$2"
  out="$3"
  if [ "$fmt" = "side-by-side" ]; then
    magick "$expected" "$actual" +append "$out"
  elif [ "$fmt" = "overlay" ]; then
    magick compare "$expected" "$actual" "$out" || true
  else
    echo "Unknown format: $fmt" >&2
    exit 1
  fi
}
if [ -n "${usage_expected:-}" ] && [ -n "${usage_actual:-}" ]; then
  make_diff "${usage_expected}" "${usage_actual}" "$tmp_dir/single.png"
  final="$tmp_dir/single.png"
else
  files="$(git diff --name-only --diff-filter=M | grep -E '\.(png|jpg|jpeg|webp|gif)$' || true)"
  if [ -z "$files" ]; then
    echo "No modified photos to diff"
    exit 0
  fi
  i=0
  echo "$files" | while IFS= read -r f; do
    i=$((i + 1))
    p="$(printf '%03d' "$i")"
    before="$tmp_dir/$p-before.png"
    pair="$tmp_dir/$p-pair.png"
    git show HEAD:"$f" > "$before"
    make_diff "$before" "$f" "$pair"
    magick -background black -fill white -gravity west -size 1600x30 "label:$f" "$pair" -append "$tmp_dir/$p-row.png"
  done
  final="$tmp_dir/final.png"
  magick "$tmp_dir"/*-row.png -append "$final"
fi
echo "Format: $fmt"
echo
if [ "${HERDR_ENV:-}" = "1" ] || [ -n "${KITTY_WINDOW_ID:-}" ] || [ "${TERM_PROGRAM:-}" = "ghostty" ] || [ "${TERM_PROGRAM:-}" = "WezTerm" ]; then
  chafa -f kitty "$final"
elif [ "${TERM_PROGRAM:-}" = "iTerm.app" ]; then
  chafa -f iterm "$final"
else
  imgview "$final" || chafa "$final" || imgcat "$final"
fi
