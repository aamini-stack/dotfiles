{
	"$schema": "https://opencode.ai/config.json",
	"instructions": [
		"~/AGENTS.md"
	],
	"permission": {
		"*": "allow"
	},
	"formatter": {
		"prettier": {
			"disabled": true
		},
		"oxfmt": {}
	},
	"lsp": {
		"typescript": {
			"command": [
				"tsgo",
				"--lsp",
				"--stdio"
			],
			"extensions": [
				".ts",
				".tsx",
				".js",
				".jsx",
				".mts",
				".cts"
			]
		}
	}
}
