{
  "tabs": [
    {
      "label": "code",
      "replace_initial": true,
      "root": {
        "type": "split",
        "direction": "right",
        "ratio": 0.5,
        "first": {
          "type": "pane",
          "label": "nvim",
          "cwd": "{WORKTREE_PATH}",
          "command": ["sh", "-c", "$HOME/.local/bin/mise x -- nvim"]
        },
        "second": {
          "type": "pane",
          "label": "opencode",
          "cwd": "{WORKTREE_PATH}",
          "command": ["sh", "-c", "$HOME/.local/bin/mise x -- opencode"]
        }
      }
    },
    {
      "label": "dev/test",
      "replace_initial": false,
      "root": {
        "type": "split",
        "direction": "right",
        "ratio": 0.5,
        "first": {
          "type": "pane",
          "label": "dev",
          "cwd": "{WORKTREE_PATH}",
          "command": ["sh", "-c", "$HOME/.local/bin/mise x -- vp run dev"]
        },
        "second": {
          "type": "pane",
          "label": "test",
          "cwd": "{WORKTREE_PATH}",
          "command": ["sh", "-c", "$HOME/.local/bin/mise x -- vp run test:ui --watch --port {WT_TEST_PORT}"]
        }
      }
    }
  ]
}
