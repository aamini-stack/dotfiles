{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "os": "#ACB0BE",
    "closer": "p:os",
    "pink": "#F5C2E7",
    "lavender": "#B4BEFE",
    "blue": "#89B4FA",
    "green": "#A6E3A1",
    "red": "#F38BA8"
  },
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:closer",
          "style": "plain",
          "template": "╭─ ",
          "type": "text"
        },
        {
          "foreground": "p:os",
          "style": "plain",
          "template": "{{ .Icon }} ",
          "type": "os"
        },
        {
          "foreground": "p:closer",
          "style": "plain",
          "template": "[",
          "type": "text"
        },
        {
          "foreground": "p:blue",
          "style": "plain",
          "template": "{{ .UserName }}@{{ .HostName }}",
          "type": "session"
        },
        {
          "foreground": "p:closer",
          "style": "plain",
          "template": "] ",
          "type": "text"
        },
        {
          "foreground": "p:pink",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "p:lavender",
          "options": {
            "branch_icon": "\ue725 ",
            "branch_ahead_icon": "↑",
            "branch_behind_icon": "↓",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_bare_info": true,
            "fetch_status": true,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "status_formats": {
              "Added": "+%d",
              "Deleted": "-%d",
              "Modified": "~%d",
              "Untracked": "+%d"
            },
            "tag_icon": "\uf412 "
          },
          "template": "{{ .HEAD }}{{ if .UpstreamGone }} ≢{{ else if or (gt .Ahead 0) (gt .Behind 0) }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ end }}{{ if or (.Working.Changed) (.Staging.Changed) }} {{ if .Working.Changed }}{{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }}|{{ end }}{{ if .Staging.Changed }}{{ .Staging.String }}{{ end }}{{ end }}",
          "style": "plain",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:closer",
          "style": "plain",
          "template": "╰─",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
