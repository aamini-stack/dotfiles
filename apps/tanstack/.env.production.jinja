# ---
# @initInfisical(projectId=, environment=production, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET)
# ---

INFISICAL_CLIENT_ID=

BETTER_AUTH_SECRET=infisical()
{% if google_auth -%}
OAUTH_PROXY_SECRET=infisical()

GOOGLE_CLIENT_ID="{{ google_client_id }}"
GOOGLE_CLIENT_SECRET=infisical()

{% endif -%}
{% if posthog -%}
# PostHog
VITE_POSTHOG_PROJECT_TOKEN="{{ posthog_project_token }}"
VITE_POSTHOG_HOST="/api/ingest"
{% endif -%}
{%- if sentry %}

# Sentry
VITE_PUBLIC_SENTRY_DSN="{{ sentry_dsn }}"
# Source-map upload token lives in Infisical for deployed builds, and in
# .env.local (varlock prompt) for local builds.
SENTRY_AUTH_TOKEN=
{% endif %}
