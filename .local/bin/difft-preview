#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
  revision)
    diff_args=(-r "$2")
    ;;
  file)
    diff_args=(-r "$2" "$3")
    ;;
  *)
    printf 'usage: %s {revision REV | file REV PATH}\n' "$0" >&2
    exit 2
    ;;
esac

jj diff --tool difft \
  --config 'merge-tools.difft.diff-args=["--color=always", "--display=inline", "--width=$width", "$left", "$right"]' \
  "${diff_args[@]}"
