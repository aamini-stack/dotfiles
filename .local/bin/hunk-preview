#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
  revision)
    diff_command=(jj diff --git --color=never -r "$2")
    ;;
  file)
    diff_command=(jj diff --git --color=never -r "$2" "$3")
    ;;
  *)
    printf 'usage: %s {revision REV | file REV PATH}\n' "$0" >&2
    exit 2
    ;;
esac

# Hunk emits its static renderer only to a TTY in a captured-pager environment.
# shellcheck disable=SC2016
"${diff_command[@]}" |
  TERM=dumb GIT_PAGER=1 script -qefc \
    'stty -echo; stty cols "${COLUMNS:-120}"; hunk pager --mode stack --no-line-numbers' \
    /dev/null |
  sed $'s/\r$//'
