#!/usr/bin/env bash
set -uo pipefail

LOCAL="${1:-}"
REMOTE="${2:-}"

if [[ -d "$LOCAL" && -d "$REMOTE" ]]; then
    WORKDIR=$(mktemp -d)
    trap 'rm -rf "$WORKDIR"' EXIT
    mkdir -p "$WORKDIR/a" "$WORKDIR/b"
    cp -rL "$LOCAL"/. "$WORKDIR/a"/
    cp -rL "$REMOTE"/. "$WORKDIR/b"/
    cd "$WORKDIR"
    { git diff --no-index -- a b || true; } | hunk patch -
else
    { git diff --no-index -- "$LOCAL" "$REMOTE" || true; } | hunk patch -
fi
