#!/usr/bin/env sh

if [ "${1:-}" = "pair" ]; then
  tailscale=false
  tailscale_port=false
  expect_tailscale_port=false
  for argument in "$@"; do
    if [ "$expect_tailscale_port" = true ]; then
      if [ "$argument" != "8443" ]; then
        printf '%s\n' 't3: Tailscale Serve port is fixed at 8443' >&2
        exit 2
      fi
      expect_tailscale_port=false
      continue
    fi
    [ "$argument" = "--tailscale" ] && tailscale=true
    case "$argument" in
      --tailscale-serve-port)
        tailscale_port=true
        expect_tailscale_port=true
        ;;
      --tailscale-serve-port=8443) tailscale_port=true ;;
      --tailscale-serve-port=*)
        printf '%s\n' 't3: Tailscale Serve port is fixed at 8443' >&2
        exit 2
        ;;
    esac
  done
  if [ "$tailscale" = true ] && [ "$tailscale_port" = false ]; then
    set -- "$@" --tailscale-serve-port 8443
  fi
fi

exec env \
  CC=/usr/bin/gcc \
  CXX=/usr/bin/g++ \
  NPM_CONFIG_CACHE="${NPM_CONFIG_CACHE:-$HOME/.cache/npm-t3}" \
  npx --yes t3@0.0.38 "$@"
