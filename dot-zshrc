#!~/.nix-profile/bin/zsh zsh

# Clear path if on WSL (Perf)
if [[ $(uname -r) =~ WSL ]]; then
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games"
fi

# ── Initialization ────────────────────────────────────────────
if [ -e $HOME/.nix-profile/etc/profile.d/nix.sh ]; then . $HOME/.nix-profile/etc/profile.d/nix.sh; fi
eval "$(mise activate zsh)"

# ── Environment ───────────────────────────────────────────────
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export EDITOR='nvim'
export VISUAL='nvim'
export TERM=xterm-256color
# ── Path ──────────────────────────────────────────────────────
export PATH="$PATH:/usr/sbin:/sbin"
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/.nix-profile/bin"
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# ── Aliases ───────────────────────────────────────────────────
alias ls='exa -1 --icons --group-directories-first'
alias vim='nvim'
alias lg='lazygit'

# ── Completion ────────────────────────────────────────────────
autoload -Uz compinit
compinit

# ── FZF ───────────────────────────────────────────────────────
source ~/.fzf/fzf.sh
export FZF_DEFAULT_COMMAND='fd . --hidden ~/Developer'
export FZF_CTRL_T_OPTS="--preview '~/.fzf/fzf-preview.sh {}'"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
bindkey ^f 'fzf ~ --preview ~/.fzf/fzf-preview.sh {}'

# ── Theme- ────────────────────────────────────────────────────
eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/themes/catppuccin.omp.json)"

