if [ -e $HOME/.nix-profile/etc/profile.d/nix.sh ]; then . $HOME/.nix-profile/etc/profile.d/nix.sh; fi 

# Mise
eval "$(mise activate zsh)"
export PATH="$HOME/.local/bin:$PATH"

export PATH="$PATH:$HOME/.nix-profile/bin"
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
export JAVA_HOME='/Users/aamini/Library/Java/JavaVirtualMachines/openjdk-17.0.1/Contents/Home'
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export EDITOR='nvim'
export VISUAL='nvim'

# ALIASES
alias lg='lazygit'
gw() {
  case "$1" in
    add)
      shift
      cd "$(git rev-parse --git-common-dir)/.." && git worktree add "$@"
      ;;
    switch|sw)
      shift
      local dir
      if [ -n "$1" ]; then
        dir="$(git worktree list --porcelain | awk '/^worktree /{print $2}' | grep -m1 "/$1\$")"
        if [ -z "$dir" ]; then
          echo "No worktree matching '$1'"
          return 1
        fi
      else
        dir="$(git worktree list --porcelain | awk '/^worktree /{print $2}' | fzf)"
      fi
      [ -n "$dir" ] && cd "$dir"
      ;;
    rm|remove)
      shift
      git worktree remove "$@"
      ;;
    *)
      echo "Usage: gw <add|switch|rm> [args...]"
      return 1
      ;;
  esac
}
alias ls='exa -1 --icons --group-directories-first'
alias vim='nvim'

source ~/scripts/fzf.sh
export FZF_CTRL_T_OPTS="--preview '~/scripts/fzf-preview.sh {}'"
bindkey ^f 'fzf ~ --preview ~/scripts/fzf-preview.sh {}'
alias e='nvim $(fzf --preview "~/scripts/fzf-preview.sh {}")'

# oh-my-posh
eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/themes/catppuccin.omp.json)"

# autocomplete
autoload -Uz compinit
compinit

_gw() {
  local -a subcmds worktrees
  if (( CURRENT == 2 )); then
    subcmds=(add switch sw rm remove)
    _describe 'subcommand' subcmds
  elif (( CURRENT == 3 )); then
    case "$words[2]" in
      switch|sw|rm|remove)
        worktrees=(${(f)"$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}' | xargs -n1 basename)"})
        _describe 'worktree' worktrees
        ;;
      add)
        _files
        ;;
    esac
  fi
}
compdef _gw gw

# pnpm
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

