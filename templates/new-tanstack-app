#!/usr/bin/env bash
# Bootstrap a new TanStack Start app from dotfiles/templates/tanstack-app.
# Usage: new-tanstack-app <kebab-case-name> [target-dir]
set -euo pipefail

name="${1:?usage: new-tanstack-app <kebab-case-name> [target-dir]}"
target="${2:-$HOME/apps/$name}"
template="$(cd "$(dirname "$0")/tanstack-app" && pwd)"

if [[ -e "$target" ]]; then
	echo "error: $target already exists" >&2
	exit 1
fi

snake="${name//-/_}"

cp -r "$template" "$target"

if [[ "$(uname)" == "Darwin" ]]; then
	sed_i() { sed -i '' "$@"; }
else
	sed_i() { sed -i "$@"; }
fi
export LC_ALL=C
find "$target" -type f -print0 | while IFS= read -r -d '' f; do
	sed_i -e "s/__APP_NAME_SNAKE__/$snake/g" -e "s/__APP_NAME__/$name/g" "$f"
done

cd "$target"
if command -v jj &>/dev/null; then
	jj git init --colocate 2>/dev/null || jj git init
fi

cat <<EOF
Created $target

Next steps:
  cd $target
  mise trust
  pnpm install
  mise run bootstrap   # or: vp run compose:up && vp run db:push
  vp dev
EOF
