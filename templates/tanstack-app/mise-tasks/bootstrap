#!/usr/bin/env bash
#MISE description="Bootstrap a fresh clone or jj workspace: tools, deps, docker, database"
set -euo pipefail

cd "$(dirname "$0")/.."

# Shells spawned from another workspace (herdr, wt hooks) inherit that
# project's exported env; stale values beat .env.development.local in both
# varlock and docker compose. Drop them so this workspace's ports win.
unset \
	APP_PORT COMPOSE_PROJECT_NAME WORKTREE_NAME \
	POSTGRES_PORT POSTGRES_DB DATABASE_URL \
	MINIO_PORT MINIO_CONSOLE_PORT \
	AWS_ENDPOINT_URL AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_S3_BUCKET_NAME

mise install

# .env.local holds only the Bitwarden machine account token (encrypted via
# varlock()); copy it from the default workspace so new workspaces can
# resolve secrets without re-pasting. Everything else is regenerated or
# resolved from Bitwarden.
main_root="$(jj workspace root --name default 2>/dev/null || true)"
if [[ -n "$main_root" && "$main_root" != "$PWD" ]]; then
	if [[ ! -f .env.local && -f "$main_root/.env.local" ]]; then
		cp "$main_root/.env.local" .env.local
		echo "copied .env.local from $main_root"
	fi
fi

vp i

# Triggers varlock(prompt) for the Bitwarden token on first run.
vp exec varlock load
if [[ -f .env.local ]]; then
	vp exec varlock encrypt --file .env.local
fi

vp exec tsx scripts/setup.ts
vp run compose:up
vp run db:migrate

echo
echo "Bootstrap complete. Run 'vp dev' to start the app."
