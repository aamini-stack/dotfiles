# Shared config for deployed environments (preview, production), imported via
# @import from .env.preview and .env.production.
# Local development never touches Bitwarden; init lives here so only deployed
# environments resolve secrets. Set BWS_ACCESS_TOKEN in .env.development.local
# (gitignored) to load this file locally.
# @initBitwarden(accessToken=$BWS_ACCESS_TOKEN)
# ---
# @type=bitwardenAccessToken @sensitive @required
BWS_ACCESS_TOKEN=

# Auth
BETTER_AUTH_SECRET=
{% if google_auth -%}
# Prod-only "Web application" OAuth client with registered redirect URIs (dev
# shares a loopback "Desktop app" client — see .env.schema).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
{% endif %}
