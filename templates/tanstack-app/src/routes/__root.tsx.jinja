import { QueryClientProvider } from '@tanstack/react-query'
import {
{%- if posthog %}
	ClientOnly,
{%- endif %}
	HeadContent,
	Outlet,
	Scripts,
	createRootRoute,
} from '@tanstack/react-router'
{%- if posthog %}
import { Suspense, lazy } from 'react'
{%- endif %}

import { queryClient } from '@/lib/utils/query'

import appCss from '../styles.css?url'
{%- if posthog %}

const PostHogInit = lazy(() =>
	import('@/lib/analytics/posthog').then((m) => ({ default: m.PostHogInit })),
)
{%- endif %}

export const Route = createRootRoute({
	head: () => ({
		meta: [
			{ charSet: 'utf-8' },
			{ name: 'viewport', content: 'width=device-width, initial-scale=1' },
			{ title: '{{ app_name }}' },
		],
		links: [{ rel: 'stylesheet', href: appCss }],
	}),
	component: RootComponent,
})

function RootComponent() {
{% if posthog %}	const posthogKey = import.meta.env.VITE_POSTHOG_PROJECT_TOKEN
	const analyticsEnabled =
		import.meta.env.VITE_APP_ENV === 'production' && posthogKey
	const content = <Outlet />
	const appContent = analyticsEnabled ? (
		<ClientOnly fallback={content}>
			<Suspense fallback={content}>
				<PostHogInit>{content}</PostHogInit>
			</Suspense>
		</ClientOnly>
	) : (
		content
	)

{% endif %}	return (
		<html lang="en">
			<head>
				<HeadContent />
			</head>
			<body>
				<QueryClientProvider client={queryClient}>
{%- if posthog %}
					{appContent}
{%- else %}
					<Outlet />
{%- endif %}
				</QueryClientProvider>
				<Scripts />
			</body>
		</html>
	)
}
