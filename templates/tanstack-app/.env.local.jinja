# Infisical machine-identity client secret. Prompted once on first
# `varlock load`, then encrypted in place.
# @sensitive
INFISICAL_CLIENT_SECRET=varlock(prompt)
{% if sentry %}
# Sentry auth token for local source-map uploads. Prompted once on first
# `varlock load`, then encrypted in place.
# @sensitive
SENTRY_AUTH_TOKEN=varlock(prompt)
{% endif %}
