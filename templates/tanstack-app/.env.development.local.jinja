# Local dev infrastructure only. Prod-scoped keys (PostHog, GTM, Sentry,
# Google OAuth) stay in .env.production; anything not set here falls
# back to schema defaults.
# ---
# @defaultSensitive=false
# ---

# @sensitive
BITWARDEN_ACCESS_TOKEN=

APP_PORT=3000

POSTGRES_PORT=5433
POSTGRES_DB={{ app_name_snake }}_dev
DATABASE_URL=postgres://app_user:app_dev@localhost:5433/{{ app_name_snake }}_dev

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=app_minio
AWS_SECRET_ACCESS_KEY=app_minio_secret
AWS_S3_BUCKET_NAME=app

# Local stand-in; in real use this resolves from Bitwarden instead.
# @sensitive
BETTER_AUTH_SECRET=dev-secret-change-me-please-32-characters
{% if google_auth %}
# One shared Google OAuth client reused by all dev apps — add each app's
# http://localhost:<port>/api/auth/callback/google redirect URI in the Google
# console once. One-time setup:
#   1. console.cloud.google.com/apis/credentials → Create OAuth client ID (Web)
#      with redirect URI http://localhost:3000/api/auth/callback/google
#   2. Store the client ID + secret as two secrets in Bitwarden Secrets Manager
#   3. Grant your machine account read access, set BITWARDEN_ACCESS_TOKEN above
#   4. Paste the two secret UUIDs below (same for every app)
GOOGLE_CLIENT_ID=bitwarden("REPLACE_WITH_CLIENT_ID_SECRET_UUID")
# @sensitive
GOOGLE_CLIENT_SECRET=bitwarden("REPLACE_WITH_SECRET_SECRET_UUID")
{% endif %}
