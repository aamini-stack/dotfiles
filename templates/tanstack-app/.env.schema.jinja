# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# ---
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# ---

# @type=bitwardenAccessToken @sensitive @optional
BITWARDEN_ACCESS_TOKEN=

# @type=enum(development, preview, staging, production, test)
APP_ENV=fallback($VARLOCK_ENV, development)

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:3000", "https://{{ app_name }}.example.com")
# @required @sensitive
BETTER_AUTH_SECRET=

# @required @type=url @sensitive
DATABASE_URL=

{% if google_auth -%}
# One shared Google OAuth client reused by all dev apps — add each app's
# http://localhost:<port>/api/auth/callback/google redirect URI in the Google
# console once. One-time setup:
#   1. console.cloud.google.com/apis/credentials → Create OAuth client ID (Web)
#      with redirect URI http://localhost:3000/api/auth/callback/google
#   2. Store the client ID + secret as two secrets in Bitwarden Secrets Manager
#   3. Grant your machine account read access and set BITWARDEN_ACCESS_TOKEN
#      in .env.development.local
#   4. Paste the two secret UUIDs below (same for every app)
# Prod apps override via .env.production with dedicated credentials.
# @required=forEnv(production, preview, staging)
GOOGLE_CLIENT_ID=if(forEnv(development), bitwarden("REPLACE_WITH_CLIENT_ID_SECRET_UUID"), "")
# @required=forEnv(production, preview, staging) @sensitive
GOOGLE_CLIENT_SECRET=if(forEnv(development), bitwarden("REPLACE_WITH_SECRET_SECRET_UUID"), "")

{% endif -%}
# @required
AWS_S3_BUCKET_NAME=
# @required
AWS_REGION="us-east-1"
# @required @type=url
AWS_ENDPOINT_URL=
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

{% if posthog -%}
# @required=forEnv(production)
VITE_PUBLIC_POSTHOG_KEY=

{% endif -%}
# @required=forEnv(production)
VITE_PUBLIC_GTM_ID=
{% if sentry -%}
# @required=forEnv(production)
VITE_PUBLIC_SENTRY_DSN=
# @required=forEnv(production) @sensitive
SENTRY_AUTH_TOKEN=
{% endif %}
