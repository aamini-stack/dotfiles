# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# ---
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/infisical-plugin)
# ---

# Set automatically by Railway; used to detect preview deploys below.
RAILWAY_ENVIRONMENT_NAME=

# @type=enum(development, preview, production, test)
APP_ENV=if(isEmpty($RAILWAY_ENVIRONMENT_NAME), remap($VARLOCK_ENV, "preview", preview, "production", production, "prod", production, "test", test, /.*/, development), remap($RAILWAY_ENVIRONMENT_NAME, "production", production, "prod", production, /.*/, preview))

# Dev-server port; mise-tasks/setup regenerates a unique value per jj
# workspace in .env.development.local.
# @type=port
APP_PORT=3000

# @type=infisicalClientId @required=forEnv(production, preview)
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @sensitive @required=forEnv(production, preview)
INFISICAL_CLIENT_SECRET=

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:${APP_PORT}", "https://{{ app_name }}.example.com")
# @required=forEnv(production, preview) @sensitive
BETTER_AUTH_SECRET=
# @required=forEnv(production, preview) @sensitive
OAUTH_PROXY_SECRET=

# @required @type=url @sensitive
DATABASE_URL=

{% if google_auth -%}
# One shared dev OAuth client reused by all apps, created once as type
# "Desktop app" — Google accepts any loopback port for those without
# registration, so every app/workspace signs in through its own daemon without
# per-app console setup. Deployed environments override with a dedicated "Web
# application" client via .env.preview / .env.production.
# @required=forEnv(production, preview)
GOOGLE_CLIENT_ID=
# @required=forEnv(production, preview) @sensitive
GOOGLE_CLIENT_SECRET=

{% endif -%}
# @required
AWS_S3_BUCKET_NAME=
# @required
AWS_REGION="us-east-1"
# @required @type=url
AWS_ENDPOINT_URL=
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

{% if posthog -%}
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=

{% endif -%}
{% if sentry -%}
# @required=forEnv(production)
VITE_PUBLIC_SENTRY_DSN=
# @required=forEnv(production) @sensitive
SENTRY_AUTH_TOKEN=
{%- endif %}
