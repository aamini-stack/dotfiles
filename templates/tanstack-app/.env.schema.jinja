# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# ---
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# Bitwarden is only used by deployed environments (see .env.deployed); dev
# secrets are local, encrypted via varlock(prompt) in gitignored files.
# @plugin(@varlock/bitwarden-plugin)
# ---

# @type=enum(development, preview, production, test)
APP_ENV=fallback($VARLOCK_ENV, development)

# Client-exposed mirror of APP_ENV; import.meta.env.MODE is "production" for
# every vite build, so it cannot distinguish deployed previews from prod.
VITE_APP_ENV=$APP_ENV

# Dev-server port; mise-tasks/setup regenerates a unique value per jj
# workspace in .env.development.local.
# @type=port
APP_PORT=3000

# @type=bitwardenAccessToken @sensitive @required=forEnv(production, preview)
BWS_ACCESS_TOKEN=

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:${APP_PORT}", "https://{{ app_name }}.example.com")
# @required @sensitive
BETTER_AUTH_SECRET=if(forEnv(development), cache(randomHex(32)))

# @required @type=url @sensitive
DATABASE_URL=

{% if google_auth -%}
# One shared dev OAuth client reused by all apps, created once as type
# "Desktop app" — Google accepts any loopback port for those without
# registration, so every app/workspace signs in through its own daemon without
# per-app console setup. Deployed environments override with a dedicated "Web
# application" client via .env.deployed.
# @required=forEnv(production, preview)
GOOGLE_CLIENT_ID="226948588184-lj4v456ith2npetoadfgu2hqjcjl8i3p.apps.googleusercontent.com"
# @required=forEnv(production, preview) @sensitive
GOOGLE_CLIENT_SECRET=

{% endif -%}
# @required
AWS_S3_BUCKET_NAME=
# @required
AWS_REGION="us-east-1"
# @required @type=url
AWS_ENDPOINT_URL=
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

{% if posthog -%}
# @required=forEnv(production)
VITE_POSTHOG_PROJECT_TOKEN=
# @required=forEnv(production)
VITE_POSTHOG_HOST=

{% endif -%}
# @required=forEnv(production)
VITE_PUBLIC_GTM_ID=
{% if sentry -%}
# @required=forEnv(production)
VITE_PUBLIC_SENTRY_DSN=
# @required=forEnv(production) @sensitive
SENTRY_AUTH_TOKEN=
{%- endif %}
