# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# ---
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/bitwarden-plugin)
{% if google_auth -%}
# Dev resolves the shared Google OAuth client from Bitwarden, so init lives
# here; without google_auth the schema stays Bitwarden-free and .env.deployed
# inits the plugin for deployed environments only.
# @initBitwarden(accessToken=$BWS_ACCESS_TOKEN)
{% endif -%}
# ---

{% if google_auth -%}
# @type=bitwardenAccessToken @sensitive @optional
BWS_ACCESS_TOKEN=

{% endif -%}
# @type=enum(development, preview, production, test)
APP_ENV=fallback($VARLOCK_ENV, development)

# Client-exposed mirror of APP_ENV; import.meta.env.MODE is "production" for
# every vite build, so it cannot distinguish deployed previews from prod.
VITE_APP_ENV=$APP_ENV

# Dev-server port; scripts/setup.ts regenerates a unique value per jj
# workspace in .env.development.local.
# @type=port
APP_PORT=3000

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:${APP_PORT}", "https://{{ app_name }}.example.com")
# @required @sensitive
BETTER_AUTH_SECRET=if(forEnv(development), cache(randomHex(32)))

# @required @type=url @sensitive
DATABASE_URL=

{% if google_auth -%}
# One shared Google OAuth client reused by all dev apps, created once as type
# "Desktop app" — Google accepts any loopback port for those without
# registration, so every app/workspace signs in through its own daemon at
# http://localhost:<port>/api/auth/callback/google (oAuthProxy bounces back to
# whatever origin you browsed, including pitchfork proxy domains). No
# per-app console setup, ever. Prod apps override via .env.deployed with a
# dedicated "Web application" client and registered redirect URIs.
# @required=forEnv(production, preview)
GOOGLE_CLIENT_ID=if(forEnv(development), bitwarden("9e2368ac-7809-4be1-9910-b49c0074e4f3"), "")
# @required=forEnv(production, preview) @sensitive
GOOGLE_CLIENT_SECRET=if(forEnv(development), bitwarden("8ee843f6-f9d9-4c04-ba41-b49c0074f582"), "")

{% endif -%}
# @required
AWS_S3_BUCKET_NAME=
# @required
AWS_REGION="us-east-1"
# @required @type=url
AWS_ENDPOINT_URL=
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

{% if posthog -%}
# @required=forEnv(production)
VITE_POSTHOG_PROJECT_TOKEN=
# @required=forEnv(production)
VITE_POSTHOG_HOST=

{% endif -%}
# @required=forEnv(production)
VITE_PUBLIC_GTM_ID=
{% if sentry -%}
# @required=forEnv(production)
VITE_PUBLIC_SENTRY_DSN=
# @required=forEnv(production) @sensitive
SENTRY_AUTH_TOKEN=
{% endif %}
