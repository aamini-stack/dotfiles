# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# ---
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# ---

# @type=bitwardenAccessToken @sensitive @optional
BITWARDEN_ACCESS_TOKEN=

# @type=enum(development, preview, staging, production, test)
APP_ENV=fallback($VARLOCK_ENV, development)

# Dev-server port; scripts/setup.ts regenerates a unique value per jj
# workspace in .env.development.local.
# @type=port
APP_PORT=3000

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:${APP_PORT}", "https://{{ app_name }}.example.com")
# @required @sensitive
BETTER_AUTH_SECRET=

# @required @type=url @sensitive
DATABASE_URL=

{% if google_auth -%}
# One shared Google OAuth client reused by all dev apps — add each app's
# https://<app>.localhost/api/auth/callback/google redirect URI in the Google
# console once. Dev OAuth proxies through that stable pitchfork slug origin
# so per-workspace localhost ports never need registering. Values resolve
# from Bitwarden Secrets Manager and only need BITWARDEN_ACCESS_TOKEN set in
# .env.development.local.
# Prod apps override via .env.production with dedicated credentials.
# @required=forEnv(production, preview, staging)
GOOGLE_CLIENT_ID=if(forEnv(development), bitwarden("9e2368ac-7809-4be1-9910-b49c0074e4f3"), "")
# @required=forEnv(production, preview, staging) @sensitive
GOOGLE_CLIENT_SECRET=if(forEnv(development), bitwarden("8ee843f6-f9d9-4c04-ba41-b49c0074f582"), "")

{% endif -%}
# @required
AWS_S3_BUCKET_NAME=
# @required
AWS_REGION="us-east-1"
# @required @type=url
AWS_ENDPOINT_URL=
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

{% if posthog -%}
# @required=forEnv(production)
VITE_PUBLIC_POSTHOG_KEY=

{% endif -%}
# @required=forEnv(production)
VITE_PUBLIC_GTM_ID=
{% if sentry -%}
# @required=forEnv(production)
VITE_PUBLIC_SENTRY_DSN=
# @required=forEnv(production) @sensitive
SENTRY_AUTH_TOKEN=
{% endif %}
