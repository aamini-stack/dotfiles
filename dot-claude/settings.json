{
  "permissions": {
    "allow": [
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:telemetry.vercel.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:github.com)",

      "Bash(pnpm i)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm serve)",
      "Bash(pnpm start)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm test:integration)",
      "Bash(pnpm test:watch)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e:update)",
      "Bash(pnpm verify)",

      "WebFetch(domain:aamini-stack-mkhhi1qe.hcp.westus.azmk8s.io)",
      "WebFetch(domain:imdbgraph.ariaamini.com)",
      "Bash(playwriter skill:*)",
      "Bash(playwriter:*)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowUnixSockets": ["/var/run/docker.sock", "~/.docker/run/docker.sock"],
      "allowLocalBinding": true
    },
    "excludedCommands": ["docker"]
  },
  "skipDangerousModePermissionPrompt": true,
  "model": "haiku"
}
