[rebase]
    updateRefs = true
[user]
    name = Aria Amini
    email = amini5454@gmail.com
[alias]
    lg = log --branches --remotes --tags --graph --oneline --decorate

[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true
[merge]
    conflictStyle = zdiff3
[init]
	defaultBranch = main
[credential]
	helper = store
