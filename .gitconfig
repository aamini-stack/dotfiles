[user]
    name = Aria Amini
    email = amini5454@gmail.com

[alias]
    lg = log --branches --remotes --tags --graph --oneline --decorate

[init]
    defaultBranch = main

[rebase]
    updateRefs = true

[merge]
    conflictStyle = zdiff3

# ============================================
# Diff tools
# ============================================

# CLI `git diff` / `git show` use Hunk as the pager.
[core]
    pager = hunk pager

# `git add -p` uses Delta for colorized hunks without breaking interactive selection.
[interactive]
    diffFilter = delta --color-only

# `git difftool` and lazygit `<ctrl+t>` use Hunk via a wrapper that
# generates a clean patch from the directory/file pairs Git provides.
[diff]
    tool = hunk

[difftool "hunk"]
    cmd = hunk-difftool "$LOCAL" "$REMOTE"

[difftool]
    prompt = false
[credential "https://github.com"]
	helper = 
	helper = !/home/aamini.linux/.local/share/mise/installs/github-cli/2.93.0/gh_2.93.0_linux_arm64/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/aamini.linux/.local/share/mise/installs/github-cli/2.93.0/gh_2.93.0_linux_arm64/bin/gh auth git-credential
