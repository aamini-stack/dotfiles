#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f /proc/sys/fs/binfmt_misc/WSLInterop ]]; then
  printf 'This script must run inside WSL.\n' >&2
  exit 1
fi

source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
windows_home=$(wslpath "$(cmd.exe /d /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')")
backup_dir="/var/backups/dotfiles-wsl/$(date -u +%Y%m%dT%H%M%SZ)"

sudo install -d -m 700 "$backup_dir"
sudo cp -a /etc/wsl.conf /etc/hosts "$backup_dir/"
if [[ -f "$windows_home/.wslconfig" ]]; then
  sudo cp -a "$windows_home/.wslconfig" "$backup_dir/windows.wslconfig"
fi
sudo install -m 644 "$source_dir/wsl.conf" /etc/wsl.conf
sudo install -m 644 "$source_dir/hosts" /etc/hosts
install -m 644 "$source_dir/.wslconfig" "$windows_home/.wslconfig"

printf 'Synced WSL configuration. Backup: %s\n' "$backup_dir"
printf 'Run `wsl --shutdown` from PowerShell to apply it.\n'
